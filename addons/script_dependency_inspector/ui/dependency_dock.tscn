tooltip_text = "Default refresh mode. Debounce Godot filesystem changes, then scan once after editing becomes quiet. Changes arriving during a scan schedule one follow-up scan."

[node name="EditorSyncDebounceLabel" type="Label" parent="MainSplit/ControlsTabs/Automation/VBox/AutomationEditorBody/EditorSyncRow"]
layout_mode = 2
